---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div role="search" class="mb-6">
            <label for="game-search" class="block text-sm font-medium text-slate-200 mb-2">
              Search games by title
            </label>
            <div class="relative">
              <input
                id="game-search"
                type="search"
                placeholder="Search games by title..."
                autocomplete="off"
                aria-controls="games-grid"
                data-testid="game-search"
                class="w-full rounded-lg border border-slate-600 bg-slate-800 px-4 py-3 pr-12 text-slate-100 placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              />
              <button
                type="button"
                aria-label="Clear game search"
                data-testid="clear-game-search"
                class="absolute right-3 top-1/2 hidden -translate-y-1/2 rounded p-1 text-slate-400 transition-colors hover:bg-slate-700 hover:text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              >
                <span aria-hidden="true" class="text-lg leading-none">&times;</span>
              </button>
            </div>
          </div>

          <div
            id="games-grid"
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
            data-testid="games-grid"
          >
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p
            class="hidden mt-6 text-center text-slate-300"
            data-testid="no-game-results"
            aria-live="polite"
          >
            No games match your search.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#game-search');
  const clearSearchButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-game-search"]');
  const gameCards = document.querySelectorAll<HTMLElement>('[data-testid="game-card"]');
  const noResultsMessage = document.querySelector<HTMLElement>('[data-testid="no-game-results"]');

  if (!searchInput || !clearSearchButton || !noResultsMessage) {
    throw new Error('Game search elements are missing from the home page.');
  }

  /** Filters game cards by their title as the user types. */
  const updateVisibleGames = (): void => {
    const searchTerm = searchInput.value.trim().toLowerCase();
    let visibleGames = 0;

    gameCards.forEach((gameCard) => {
      const title = gameCard.dataset.gameTitle?.toLowerCase() ?? '';
      const isMatch = title.includes(searchTerm);

      gameCard.hidden = !isMatch;
      if (isMatch) {
        visibleGames += 1;
      }
    });

    noResultsMessage.hidden = visibleGames > 0;
    noResultsMessage.classList.toggle('hidden', visibleGames > 0);
    clearSearchButton.classList.toggle('hidden', searchTerm.length === 0);
  };

  searchInput.addEventListener('input', updateVisibleGames);
  clearSearchButton.addEventListener('click', () => {
    searchInput.value = '';
    updateVisibleGames();
    searchInput.focus();
  });
</script>
